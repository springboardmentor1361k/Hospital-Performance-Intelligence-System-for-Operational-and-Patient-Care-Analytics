      <column caption='Tot_admission_%' datatype='real' name='[Calculation_0741663918088192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( COUNT([Admission_id]) /  [Calculation_1356290627174405] ) * 100' />
      </column>
      <column caption='Avg_LOS' datatype='real' name='[Calculation_0741663936970753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Length_of_stay_days])' />
      </column>
      <column caption='Bed_occup_%' datatype='real' name='[Calculation_1356290593542144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( sum([Occupied_beds_count]) / SUM([Total_beds]) ) * 100' />
      </column>
      <column caption='Eligible_readmission' datatype='integer' name='[Calculation_1356290596925441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Readmission_within_30_days]=0 THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Readmission_rate%' datatype='real' name='[Calculation_1356290602901506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(( SUM([Readmission_flag])-( COUNT([Admission_id]) - SUM([Calculation_1356290596925441])) )  / SUM([Calculation_1356290596925441]) ) *100' />
      </column>
      <column caption='mortality rate % ' datatype='real' name='[Calculation_1356290622697475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM([Mortality_flag]) / COUNT([Admission_id]) ) * 100' />
      </column>
      <column caption='Discharge count' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1356290623639556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Discharge_status] ==&quot;Discharged&quot; THEN 1 &#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Tot_Admission_count' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1356290627174405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Admission_id])' />
      </column>
