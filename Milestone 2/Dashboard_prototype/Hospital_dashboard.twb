              <calculation class='tableau' formula='( sum([Occupied_beds_count]) / SUM([Total_beds]) ) * 100' />
            </column>
            <column caption='Eligible_readmission' datatype='integer' name='[Calculation_1356290596925441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Readmission_within_30_days]=0 THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Readmission_rate%' datatype='real' name='[Calculation_1356290602901506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(( SUM([Readmission_flag])-( COUNT([Admission_id]) - SUM([Calculation_1356290596925441])) )  / SUM([Calculation_1356290596925441]) ) *100' />
            </column>
            <column caption='mortality rate % ' datatype='real' name='[Calculation_1356290622697475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM([Mortality_flag]) / COUNT([Admission_id]) ) * 100' />
